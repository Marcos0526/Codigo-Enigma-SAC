# ============================================================================
# Semantic Data Discovery & Interactive Dashboards - Environment Variables
# ============================================================================
# Copy this file to .env and fill in the values. Never commit .env with real secrets.

# ----------------------------------------------------------------------------
# Application
# ----------------------------------------------------------------------------
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
LOG_LEVEL=info

# Local NASA PSI source used by the general web page (no synthetic data or DB required)
DATA_SOURCE=local
PSI_DATA_DIR=data/psi_databases
NASA_RAG_CACHE=services/search/src/rag/.cache/psi_data
NASA_RAG_EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
NASA_RAG_TOP_K=5

# ----------------------------------------------------------------------------
# Legacy database catalog (only used with DATA_SOURCE=database)
# ----------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/enigma_sac
DATABASE_POOL_SIZE=10
DATABASE_SSL=false

# ----------------------------------------------------------------------------
# Vector Store (pgvector)
# ----------------------------------------------------------------------------
VECTOR_DIMENSIONS=384
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_VERSION=1.0.0

# ----------------------------------------------------------------------------
# Embedding Service
# ----------------------------------------------------------------------------
# Options: local, openai, nvidia, remote
EMBEDDING_PROVIDER=local
EMBEDDING_API_KEY=
EMBEDDING_API_URL=http://localhost:8080/embed

# NVIDIA API (when using EMBEDDING_PROVIDER=nvidia)
# Get your API key from https://build.nvidia.com/
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1

# ----------------------------------------------------------------------------
# LLM Service (optional, OpenAI-compatible)
# ----------------------------------------------------------------------------
# The local RAG chat works without a key and returns cited retrievals.
# With a key, the model receives the selected dataset context as [S] plus the
# retrieved NASA PSI context as [1], [2], ... and must cite both.
# Any OpenAI-compatible endpoint works: OpenAI, Groq, NVIDIA, vLLM, Ollama, etc.
# Leave LLM_API_KEY empty to use retrieval-only answers.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_API_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=2000
LLM_TEMPERATURE=0.1

# Groq example:
# LLM_API_KEY=gsk_...
# LLM_API_URL=https://api.groq.com/openai/v1
# LLM_MODEL=qwen/qwen3.8-27b
#
# NVIDIA example:
# LLM_API_KEY=nvapi-...
# LLM_API_URL=https://integrate.api.nvidia.com/v1
# LLM_MODEL=meta/llama-3.1-70b-instruct
#
# Local Ollama example (OpenAI-compatible endpoint):
# LLM_API_KEY=ollama
# LLM_API_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1

# ----------------------------------------------------------------------------
# Data Connectors (Allowlisted domains only)
# ----------------------------------------------------------------------------
# Comma-separated list of allowed domains for data downloads
ALLOWED_DATA_DOMAINS=psi.nasa.gov,raw.githubusercontent.com,data.nasa.gov
# Maximum file size for downloads (bytes)
MAX_DOWNLOAD_SIZE=104857600
# Download timeout (seconds)
DOWNLOAD_TIMEOUT=30

# ----------------------------------------------------------------------------
# Search Service
# ----------------------------------------------------------------------------
SEARCH_MIN_SCORE=0.3
SEARCH_MAX_RESULTS=100
SEARCH_RERANK_ENABLED=false
SEARCH_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ----------------------------------------------------------------------------
# Profiling & Visualization Limits
# ----------------------------------------------------------------------------
MAX_PROFILE_ROWS=100000
MAX_PROFILE_MEMORY_MB=512
MAX_PROFILE_TIME_SECONDS=60
MAX_CHART_ROWS=10000
MAX_CHART_MEMORY_MB=256
MAX_CHART_TIME_SECONDS=30

# ----------------------------------------------------------------------------
# Security
# ----------------------------------------------------------------------------
# Enable SSRF protection (block private/local IPs)
SSRF_PROTECTION_ENABLED=true
# Allowed IP ranges for connectors (CIDR notation)
ALLOWED_IP_RANGES=
# API rate limiting (requests per minute)
RATE_LIMIT_RPM=60

# ----------------------------------------------------------------------------
# Catalog
# ----------------------------------------------------------------------------
CATALOG_VERSION=1.0.0
CATALOG_SOURCE_URL=https://psi.nasa.gov/physci/repo/search?q=combustion&data_source=psi&data_type=investigation
CATALOG_PSI_INDEX_CSV=https://raw.githubusercontent.com/Krypton-N/NASA-SPACE-APPS/main/data/psi/psi_index.csv

# ----------------------------------------------------------------------------
# Frontend (Web App)
# ----------------------------------------------------------------------------
WEB_PORT=3000
WEB_API_URL=http://localhost:8000/api/v1