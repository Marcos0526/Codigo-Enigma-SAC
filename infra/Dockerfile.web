# ============================================================================
# Enigma SAC Web Frontend - Dockerfile
# ============================================================================

FROM node:22-bookworm-slim AS deps
WORKDIR /app

# Install the root workspace and its lockfile dependencies. The root dev
# dependencies include TypeScript, which Next.js needs during `next build`.
COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/package.json
COPY packages/contracts/package.json packages/contracts/package.json
RUN npm ci

FROM node:22-bookworm-slim AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY package.json package-lock.json ./
COPY apps/web/ ./apps/web/
COPY packages/contracts/ ./packages/contracts/
RUN npm run build --workspace @enigma-sac/web

FROM node:22-bookworm-slim AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

RUN addgroup --system --gid 1001 nodejs \
    && adduser --system --uid 1001 nextjs

COPY --from=builder /app/apps/web/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/public ./apps/web/public

USER nextjs
WORKDIR /app/apps/web
EXPOSE 3000

# The web server proxies /api/v1/* to this backend. Override it for other
# hosting environments; the value must be reachable from the web container.
ENV API_BACKEND_URL=http://api:8000

CMD ["node", "server.js"]
