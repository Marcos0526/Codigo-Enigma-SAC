{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.enigma-sac.org/summary-request.json",
  "title": "Summary Request",
  "type": "object",
  "required": ["datasetId"],
  "properties": {
    "datasetId": {
      "type": "string",
      "description": "Stable unique identifier for the dataset"
    },
    "options": {
      "type": "object",
      "properties": {
        "includeStatistics": {
          "type": "boolean",
          "default": true,
          "description": "Include computed statistics in the summary"
        },
        "maxLength": {
          "type": "integer",
          "minimum": 100,
          "maximum": 5000,
          "default": 1000,
          "description": "Maximum length of the summary in characters"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}