{
  "name": "@enigma-sac/contracts",
  "version": "1.0.0",
  "description": "Shared contracts, types, and JSON schemas for Semantic Data Discovery & Interactive Dashboards",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./schemas/*": "./src/schemas/*.json"
  },
  "scripts": {
    "build": "tsc",
    "validate": "node scripts/validate-schemas.js",
    "test": "vitest run",
    "lint": "eslint src --ext .ts"
  },
  "keywords": [
    "contracts",
    "schemas",
    "types",
    "nasa",
    "psi",
    "combustion"
  ],
  "author": "Enigma SAC",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0",
    "ajv": "^8.12.0",
    "ajv-formats": "^2.1.0"
  },
  "files": [
    "dist",
    "src/schemas"
  ]
}